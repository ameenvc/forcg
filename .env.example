# SaaS mode: DB_DATABASE must be a dedicated platform database. See docs/tenancy.md.
TENANCY_ENABLED=false
TENANCY_BASE_DOMAIN=cgbod.com
TENANCY_TENANT_BASE_DOMAIN=cgbod.com
# Optional custom platform hostname (no scheme or path):
# TENANCY_ADMIN_DOMAIN=devsaas.cgbod.com
TENANCY_SOURCE_CONNECTION=mysql
TENANCY_HOST_PREFIX=""
TENANCY_SCHEME=https
TENANCY_DATABASE_PREFIX=cgbod_

# This deployment's hosting node. Existing tenants with no assignment belong to local.
TENANCY_NODE_ID=local
# Optional JSON catalog, identical on all nodes (IDs map to name and region).
# TENANCY_HOSTING_NODES='{"local":{"name":"Current server","region":"Default region"}}'
# Set on a regional node with a separate tenant database server:
# TENANCY_TENANT_CONNECTION=tenant_host
# TENANT_DB_HOST=127.0.0.1
# TENANT_DB_PORT=3306
# TENANT_DB_USERNAME=
# TENANT_DB_PASSWORD=
