pipeline {
    agent any

    environment {
        SPTC_USER        = 'minhaj'
        SPTC_HOST        = '65.20.72.209'
        DEPLOY_PATH      = '/home/admin/web/sptc.cgbod.com/public_html/quickqmlaravel'
        PHP_BIN          = 'php'
        GIT_BRANCH_NAME  = 'master'
        SSH_CRED_ID      = 'sptc-minhaj-deploy'
    }

    stages {

        stage('Git Pull') {
            steps {
                sshagent(credentials: [SSH_CRED_ID]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${SPTC_USER}@${SPTC_HOST} '
                            cd ${DEPLOY_PATH} &&
                            sudo chmod -R 777 storage bootstrap/cache &&
                            git fetch origin &&
                            git checkout ${GIT_BRANCH_NAME} &&
                            git reset --hard origin/${GIT_BRANCH_NAME} &&
                            git pull origin ${GIT_BRANCH_NAME}
                        '
                    """
                }
            }
        }

        stage('Composer Install') {
            steps {
                sshagent(credentials: [SSH_CRED_ID]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${SPTC_USER}@${SPTC_HOST} '
                            cd ${DEPLOY_PATH} &&
                            composer install --no-dev --optimize-autoloader --no-interaction
                        '
                    """
                }
            }
        }

        stage('Artisan: cache + migrate') {
            steps {
                sshagent(credentials: [SSH_CRED_ID]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${SPTC_USER}@${SPTC_HOST} '
                            cd ${DEPLOY_PATH} &&
                            ${PHP_BIN} artisan config:cache &&
                            ${PHP_BIN} artisan view:cache &&
                            ${PHP_BIN} artisan migrate --force
                        '
                    """
                }
            }
        }
    }

    post {
        failure {
            echo "Deploy to sptc.cgbod.com (PROD) FAILED"
        }
        success {
            echo "Deploy to sptc.cgbod.com (PROD) succeeded"
        }
    }
}